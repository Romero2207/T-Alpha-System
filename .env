# --- BYBIT API ---
# В кабинете Bybit создай API-ключ (System-generated)
# Разрешения: Unified Trading (Read-Write). Галочку "Withdrawal" НЕ СТАВИТЬ!
BYBIT_API_KEY=твой_публичный_ключ
BYBIT_API_SECRET=твой_секретный_ключ

# --- GIGACHAT API ---
# Возьми "Авторизационные данные" в кабинете разработчика Сбера
# Это очень длинная строка (Base64)
GIGACHAT_CREDENTIALS=MDE5Y2ZhNjgtZjg5ZC03Nzc1LWI0NjgtZDQwNzY4YzYzYmMzOmEwMmU4Y2FmLTIxYTktNGQwMS04YThhLTA2MjdlNzA1M2M5Zg==

# --- T-INVEST API ---
